generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}



model users {
  id        Int        @id @default(autoincrement())
  name      String
  age       Int
  email     String
  password  String
  role      users_role
  birthAt   DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
}

enum users_role {
  ADMIN
  USER
}
