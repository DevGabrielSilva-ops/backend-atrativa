generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}



model users {
  id        Int        @id @default(autoincrement())
  name      String
  age       Int
  email     String
  password  String
  role      users_role
  birthAt   DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
}

model Products {
  id  Int @id @default(autoincrement())
  bar_code String
  name String
  qtd Int
  price Int
  type type_product
}

enum users_role {
  ADMIN
  USER
}

enum type_product {
  ROUPAS
  ACESSÓRIOS
  CASA
}
